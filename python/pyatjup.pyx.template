cdef class Jupiter:
    """ 
    Cython wrapper class for C++ class Jupiter
    """
    cdef:
        cJupiterModel *_thisptr

    def __cinit__(Jupiter self):
        # Initialize the "this pointer" to NULL so __dealloc__
        # knows if there is something to deallocate. Do not 
        # call new cJupiterModel() here.
        self._thisptr = NULL
        
    def __init__(Jupiter self):
        # Constructing the C++ object might raise std::bad_alloc
        # which is automatically converted to a Python MemoryError
        # by Cython. We therefore need to call "new cJupiterModel()" in
        # __init__ instead of __cinit__.
        self._thisptr = new cJupiterModel() 

    def __dealloc__(Jupiter self):
        # Only call del if the C++ object is alive, 
        # or we will get a segfault.
        if self._thisptr != NULL:
            del self._thisptr
            
    cdef int _check_alive(Jupiter self) except -1:
        # Because of the context manager protocol, the C++ object
        # might die before PyJupiter self is reclaimed.
        # We therefore need a small utility to check for the
        # availability of self._thisptr
        if self._thisptr == NULL:
            raise RuntimeError("Wrapped C++ object is deleted")
        else:
            return 0

    def load_config(Jupiter self, str filename):
        self._check_alive()
        self._thisptr.LoadConfig(filename)
        return None

    def run(Jupiter self):
        self._check_alive()
        self._thisptr.Run()
        return None

